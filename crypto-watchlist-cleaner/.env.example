# =============================================================
# Crypto Watchlist Cleaner 环境变量配置示例
# 复制为 .env.local 并按需填写（Vite 仅注入 VITE_ 前缀变量到前端）
# 未配置任何 Key 时，应用会自动回退到 Mock / Demo 数据。
# =============================================================

# ---------- 数据源开关 ----------
# mock  | coingecko | binance | dexscreener
VITE_DATA_SOURCE=mock

# ---------- CoinGecko ----------
VITE_COINGECKO_API_KEY=

# ---------- CoinMarketCap ----------
VITE_CMC_API_KEY=

# ---------- Binance ----------
VITE_BINANCE_API_URL=https://api.binance.com

# ---------- DexScreener ----------
VITE_DEXSCREENER_API_URL=https://api.dexscreener.com

# ---------- AI 分析（可选，缺省使用规则引擎生成本地摘要） ----------
VITE_AI_API_URL=
VITE_AI_API_KEY=

# ---------- 刷新间隔（秒） ----------
VITE_REFRESH_INTERVAL_SECONDS=300